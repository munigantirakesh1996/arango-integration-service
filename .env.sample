# Environment
NODE_ENV=development

# Server
PORT=8080

# ArangoDB System Configuration
ARANGO_SYS_URL=http://localhost:8529
ARANGO_SYS_DB=_system
ARANGO_SYS_USER=root
ARANGO_SYS_PASSWORD=root

# ArangoDB Application Configuration
ARANGO_APP_URL=http://localhost:8529
ARANGO_APP_DB=Getting-Started
ARANGO_APP_USER=root
ARANGO_APP_PASSWORD=root


#Redis configuration
REDIS_HOST=localhost
REDIS_PORT=6379

#Queue configuration
QUEUE_NAME=flightBookings
QUEUE_HOST_ID=Flight Booking Redis